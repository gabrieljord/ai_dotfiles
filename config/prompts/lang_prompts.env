# ==============================================================================
# Language-Specific Vocabulary Prompts for Whisper Speech-to-Text
# ==============================================================================
# Whisper.cpp uses the initial_prompt / --prompt parameter to bias language model
# token probabilities. Supplying relevant programming vocabulary, keywords, and
# casing conventions eliminates technical homophones (e.g. "sink" vs "sync",
# "four loop" vs "for loop", "bull" vs "bool", "a sink" vs "async").
#
# Variable format: PROMPT_<UPPERCASE_EXTENSION>
# Fallback variable: PROMPT_DEFAULT
# ==============================================================================

# Python
PROMPT_PY="Python, async, await, def, dict, list, tuple, snake_case, kwargs, args, self, cls, lambda, elif, None, True, False, import, from, return, yield, Exception, try, except, finally, with, __init__, str, int, float, bool, dataclass, pydantic"

# Rust
PROMPT_RS="Rust, fn, mut, impl, struct, enum, Result, Option, match, Vec, pub, crate, use, let, const, static, trait, where, unsafe, loop, while, for, if, else, return, Ok, Err, Some, None, panic, cargo, println, borrow, reference, deref, lifetime, &'a"

# TypeScript / TSX
PROMPT_TS="TypeScript, interface, type, const, let, function, return, export, import, from, async, await, Promise, undefined, null, boolean, string, number, any, unknown, never, readonly, class, implements, extends, arrow function, typeof, keyof"
PROMPT_TSX="TypeScript, TSX, React, useState, useEffect, useContext, useMemo, useCallback, useRef, FC, JSX, props, className, onClick, children, fragment, component, return, interface, type, HTMLDivElement"

# JavaScript / JSX
PROMPT_JS="JavaScript, ES6, const, let, var, function, return, async, await, Promise, import, export, default, class, extends, constructor, this, null, undefined, Object, Array, console.log, arrow function, callback, map, filter, reduce"
PROMPT_JSX="JavaScript, JSX, React, useState, useEffect, component, props, className, onClick, return, div, span, button, input, form, render"

# Go / Golang
PROMPT_GO="Go, golang, func, package, import, return, var, const, type, struct, interface, chan, select, defer, go, if, else, for, range, switch, case, default, nil, true, false, iota, make, len, cap, panic, recover, error, Goroutine, context.Context"

# C / C++
PROMPT_C="C, printf, malloc, free, sizeof, NULL, typedef, struct, enum, union, include, stdio.h, stdlib.h, stdbool.h, int, char, void, float, double, pointer, return, size_t"
PROMPT_CPP="C++, cpp, std, vector, string, auto, template, typename, class, struct, public, private, protected, virtual, override, nullptr, constexpr, static_cast, dynamic_cast, namespace, using, include, int, void, double, float, bool, return, std::move, unique_ptr, shared_ptr"
PROMPT_H="C, C++, header, include guard, define, ifndef, endif, pragma once, extern, struct, typedef, enum, prototype"
PROMPT_HPP="C++, header, pragma once, namespace, class, template, typename, inline, constexpr, include, std"

# Shell scripting (Bash / Zsh / POSIX sh)
PROMPT_SH="bash, sh, zsh, echo, printf, if, then, elif, else, fi, for, in, do, done, while, until, case, esac, function, return, exit, export, local, readonly, set -euo pipefail, grep, sed, awk, cat, curl, jq, chmod, mkdir, rm"
PROMPT_BASH="$PROMPT_SH"
PROMPT_ZSH="$PROMPT_SH"

# SQL / Databases
PROMPT_SQL="SQL, SELECT, FROM, WHERE, JOIN, LEFT JOIN, INNER JOIN, RIGHT JOIN, GROUP BY, ORDER BY, HAVING, INSERT INTO, UPDATE, SET, DELETE, CREATE TABLE, ALTER TABLE, DROP, INDEX, PRIMARY KEY, FOREIGN KEY, NULL, AND, OR, NOT, IN, AS, COUNT, SUM, AVG, LIMIT, OFFSET"

# Web Markup & Styling
PROMPT_HTML="HTML, doctype, html, head, title, body, div, span, header, footer, section, article, nav, a, href, img, src, button, input, form, table, tr, td, th, ul, ol, li, class, id, placeholder"
PROMPT_CSS="CSS, selector, display, flex, grid, margin, padding, border, color, background, font-size, width, height, justify-content, align-items, media query, rem, px, calc, var, box-shadow, z-index"
PROMPT_SCSS="SCSS, Sass, nesting, mixin, include, extend, variable, function, display, flex, grid, margin, padding, border, color"

# Data & Config Formats
PROMPT_JSON="JSON, key, value, string, number, boolean, array, object, null, curly braces, square brackets, colon, comma"
PROMPT_YAML="YAML, key, value, list, mapping, indent, colon, dash, boolean, string, number, dictionary"
PROMPT_YML="$PROMPT_YAML"
PROMPT_TOML="TOML, table, section, key, value, string, integer, boolean, array, inline table, brackets"

# Documentation & Prose
PROMPT_MD="Markdown, heading, bullet list, ordered list, link, image, bold, italic, code block, backticks, blockquote, table, task list, frontmatter"
PROMPT_TXT="plain text, sentence, paragraph, note, memo, bullet point"

# Generic Fallback (Used when file extension is unknown or omitted)
PROMPT_DEFAULT="code, programming, function, variable, parameter, argument, return, class, method, import, package, string, integer, float, boolean, null, undefined, true, false, if, else, loop, async, await, try, catch, snake_case, camelCase, PascalCase"
