# ==============================================================================
# AI_DOTFILES ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.
# Supported Deployments: Local Workstation (Standalone) or Client-Server Pipeline.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Mode & General Settings
# ------------------------------------------------------------------------------
# Mode: "local" (runs whisper & LLM locally) or "remote" (streams audio to server)
PIPELINE_MODE=local

# Logging level: DEBUG, INFO, WARN, ERROR
AI_LOG_LEVEL=INFO

# Temporary directory for audio processing and transcripts
AI_TMP_DIR="/tmp/ai_dotfiles"

# ------------------------------------------------------------------------------
# 2. Remote Home Server Network Configuration (Ignored if PIPELINE_MODE=local)
# ------------------------------------------------------------------------------
# IP address or Tailscale/LAN hostname of the AI compute server
AI_SERVER_HOST="192.168.1.100"

# Ports for remote services
WHISPER_SERVER_PORT=8178
OLLAMA_SERVER_PORT=11434

# Authentication token if proxy/reverse auth is enabled (optional)
AI_SERVER_AUTH_TOKEN=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Whisper Speech-to-Text Configuration (whisper.cpp)
# ------------------------------------------------------------------------------
# Path to compiled whisper.cpp binary ('whisper-cli' or 'main' or 'whisper-server')
# Default searches ~/.local/bin/whisper-cli, whisper-cli in PATH, or compiled build tree
WHISPER_BIN_PATH="${HOME}/.local/bin/whisper-cli"

# Models directory where GGML models reside
WHISPER_MODELS_DIR="$HOME/.local/share/whisper.cpp/models"

# Active Whisper Model:
# Options for ThinkPad X1 Carbon / Laptops (Intel Core i7):
#   - ggml-tiny.en.bin        (74 MB, fastest CPU inference, sub-second latency, ideal for ThinkPad i7)
#   - ggml-tiny.en-q5_1.bin   (31 MB, smallest possible quantized model, lowest RAM footprint)
#   - ggml-base.en.bin        (148 MB, high accuracy with low latency on modern CPUs)
#   - ggml-large-v3-turbo.bin (1.6 GB, heavy accuracy model, high CPU load on laptops)
WHISPER_MODEL="ggml-tiny.en.bin"
WHISPER_MODEL_PATH="${WHISPER_MODELS_DIR}/${WHISPER_MODEL}"

# Hardware & CPU Optimization:
# CPU thread count (Recommended: set to your physical CPU core count, e.g. 4 or 8)
WHISPER_THREADS=4
# GPU offload layers (0 = CPU only, completely disables CUDA/Metal/Vulkan allocation)
WHISPER_N_GPU_LAYERS=0

# Audio input recording settings
AUDIO_RECORDER="auto"                 # "auto" (Python VAD), "pyaudio", "arecord", "sox", or "ffmpeg"
AUDIO_DEVICE="default"                # PulseAudio / ALSA device name or index
AUDIO_SAMPLE_RATE=16000               # Whisper native rate (16kHz)
AUDIO_CHANNELS=1                      # Mono
AUDIO_SILENCE_THRESHOLD="2.0%"        # End-of-speech silence detection threshold (percentage or RMS int)
AUDIO_SILENCE_DURATION="5.0"          # Duration of silence to trigger stop (seconds)
AUDIO_LISTEN_TIMEOUT=30               # Seconds to wait for initial speech while listening before timing out
AUDIO_MAX_DURATION=120                # Max total recording duration (seconds)

# ------------------------------------------------------------------------------
# 4. LLM & Prompt Optimization Configuration (Ollama / LM Studio / Gemini)
# ------------------------------------------------------------------------------
# LLM Provider for dictate-v2 decoder: "ollama" (local/remote) or "gemini" (cloud)
LLM_PROVIDER="ollama"

# Google Gemini API Key (required when LLM_PROVIDER="gemini")
GEMINI_API_KEY=""

# API Endpoint for the LLM runner (used when LLM_PROVIDER="ollama")
# Local: http://localhost:11434 | Remote: http://${AI_SERVER_HOST}:11434
LOCAL_LLM_ENDPOINT="http://localhost:11434"

# Model name registered in Ollama/LM Studio or Gemini (e.g. "gemini-3.8-flash")
# Recommended for Ollama: "llama3:8b-instruct-q8_0", "mistral:7b-instruct-v0.3-q5_k_m",
# or custom fine-tuned optimizer model: "prompt-optimizer:latest"
LLM_MODEL_NAME="llama3:8b-instruct-q8_0"

# Generation parameters for prompt transformation
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=15

# System prompt preset file (located in config/ollama/system-prompts/)
# Options: "code-prompt-optimizer.txt", "dictation-cleaner.txt", "raw-passthrough.txt"
LLM_SYSTEM_PROMPT_FILE="$HOME/.config/ai_dotfiles/ollama/system-prompts/code-prompt-optimizer.txt"

# ------------------------------------------------------------------------------
# 5. IDE & System Integration (Cursor, VS Code, Clipboard)
# ------------------------------------------------------------------------------
# Target IDE for injection: "cursor", "vscode", or "clipboard"
IDE_TARGET="cursor"

# Cursor/VS Code Command-line Binary
IDE_BIN="cursor"

# Method to deliver formatted prompt:
# "clipboard" : Copies optimized prompt to system clipboard and issues paste keystroke
# "api"       : Posts directly to IDE extension / webhook listener
# "stdout"    : Prints directly to standard out
DISPATCH_METHOD="clipboard"

# Clipboard tool: "auto" (detects wl-copy, xclip, xsel, pbcopy) or specify binary
CLIPBOARD_TOOL="auto"

# Automatically simulate Ctrl+V / Cmd+V keystroke after copying to clipboard
# Requires xdotool (X11) or ydotool/wtype (Wayland)
AUTO_PASTE_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Dynamic Language Context & Grammar Rules (dictate.sh)
# ------------------------------------------------------------------------------
# Location of language-specific initial_prompt mappings for Whisper vocabulary biasing
LANG_PROMPTS_FILE="$HOME/.config/ai_dotfiles/prompts/lang_prompts.env"

# Directory containing markdown grammar definitions (spoken macros, casing rules)
WHISPER_GRAMMARS_DIR="$HOME/.config/ai_dotfiles/whisper/grammars"

# Default fallback file extension if not provided by IDE
DEFAULT_LANG_EXT="py"

# ------------------------------------------------------------------------------
# 7. Wake Word & Voice Activation Settings (ai-dictate)
# ------------------------------------------------------------------------------
# Enable wake word verification (true = required, false = disabled)
WAKE_WORD_ENABLED=false

# Custom wake word or phrase (e.g. "computer", "jarvis", "whisper", "hey dotfile")
# Case-insensitive. Optional conversational fillers ("hey", "um", "ok") are tolerated.
# Multiple alternate wake words can be specified: e.g. "computer|jarvis"
WAKE_WORD="computer"

# Automatically strip wake word and trailing punctuation from transcribed prompt
# before passing to LLM (true = strip wake word, false = keep raw transcript)
WAKE_WORD_STRIP=true

# ------------------------------------------------------------------------------
# 8. Desktop Notifications (Continuous Daemon Mode -c)
# ------------------------------------------------------------------------------
# Show desktop notifications across screen when running in continuous mode (-c)
NOTIFY_ON_CONTINUOUS=true

# Notification popup duration in milliseconds (e.g. 3000 = 3s)
NOTIFY_TIMEOUT_MS=3000
