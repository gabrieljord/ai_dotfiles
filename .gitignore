# Git ignore rules for ai_dotfiles
.env
.env.local
*.log
*.tmp
*.wav
*.mp3

# Build & Model Artifacts
models/
whisper.cpp/
*.bin
*.gguf

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Generated Convenience Symlinks (created by setup.sh & install.sh)
/dictate.sh
/transcribe.sh
/record.py
/whisper
/prompts
config/whisper/grammers
config/.env
